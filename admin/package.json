{
  "name": "codeclove-school-management-admin",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:admin": "vite build",
    "build:portal": "vite build --config vite.portal.config.ts",
    "build": "tsc --noEmit && npm run build:admin && npm run build:portal",
    "build:free": "node ../scripts/build-free.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:extract": "tsc --project tsconfig.json --outDir .i18n-temp --module esnext --target es2020 --jsx react-jsx --noEmit false --declaration false --allowImportingTsExtensions false && wp i18n make-pot .. ../languages/codeclove-school-management.pot --domain=codeclove-school-management --exclude=node_modules,vendor,admin,portal,assets/build && wp i18n make-pot .i18n-temp ../languages/codeclove-school-management.pot --domain=codeclove-school-management --merge && rm -rf .i18n-temp",
    "i18n:json": "wp i18n make-json ../languages/ --no-purge && node scripts/consolidate-i18n.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.62.7",
    "@wordpress/i18n": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.9"
  }
}
